# PayOS credentials (from my.payos.vn)
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here

# App URLs (update after deploying to Render)
APP_RETURN_URL=smartnaptimer://payment/success
APP_CANCEL_URL=smartnaptimer://payment/cancel
BACKEND_URL=https://your-app.onrender.com

# Server
PORT=3000
